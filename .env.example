# Copy to .env and fill in.

# Only needed if running the llamacpp service itself (profile "llamacpp").
# If pointing at an already-running llama.cpp instance (e.g. on the host),
# leave this unset and override LLAMACPP_BASE_URL for the ingestor service.
MODEL_FILE=

NEO4J_PASSWORD=testpassword

# Both optional — see README's "Configuring sources". Unset means "whole
# inbox", matching Gmail's own default.
GMAIL_LABEL=
GMAIL_QUERY=
